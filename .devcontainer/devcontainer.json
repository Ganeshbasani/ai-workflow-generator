{
  "name": "AI Workflow Generator (Python 3.12)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "web/src/App.tsx"
      ]
    },
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "python -m pip install --upgrade pip && python -m pip install -r requirements-dev.txt && npm --prefix web ci && python -m pre_commit install || true",
  "postAttachCommand": {
    "api": "uvicorn api:app --host 0.0.0.0 --port 8000",
    "web": "npm --prefix web run dev -- --host 0.0.0.0"
  },
  "portsAttributes": {
    "5173": {
      "label": "React workflow studio",
      "onAutoForward": "openPreview"
    },
    "8000": {
      "label": "FastAPI",
      "onAutoForward": "notify"
    }
  },
  "forwardPorts": [
    5173,
    8000
  ]
}
