# Copy this file to .env (which is git-ignored) and fill in real values.
# Docker Compose passes these settings into the full-stack app.
# Use an API key for a hosted model, or a base URL for a local Ollama model.
# If both are blank, generation uses the clearly marked offline draft mode.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8765

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# For Ollama running on the Windows host while this app runs in Docker, use:
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=<exact model name shown by `ollama list`>
# LLM_API_KEY can remain blank for local Ollama.
# If running the API directly on the host, use http://localhost:11434/v1 instead.
LLM_BASE_URL=
REQUEST_TIMEOUT_SECONDS=20
# Local Ollama model load and generation budget; independent of hosted APIs.
OLLAMA_REQUEST_TIMEOUT_SECONDS=240
OLLAMA_CONTEXT_TOKENS=4096
# Local response budget; raise for longer flows on faster hardware.
OLLAMA_MAX_OUTPUT_TOKENS=1000
TEMPERATURE=0

# Reliability / budget controls
MAX_REPAIR_RETRIES=2
RETRY_BACKOFF_SECONDS=0.5
MAX_REQUESTS_PER_SESSION=100
DAILY_COST_CEILING_USD=1.0

# Runtime limits enforced by the application
MAX_INPUT_CHARS=4000
MAX_CONTEXT_CHARS=20000

# Persistence (Phase 3). Override for a writable cloud volume.
DATABASE_PATH=workflows.db

# Optional PostHog browser analytics. Leave the public project key blank to
# keep analytics unavailable. Users must also opt in inside Workspace Settings.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
